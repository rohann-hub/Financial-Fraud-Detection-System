# Scoring service, analyst API and replay producer. No PyTorch here: graph scores come from Feast.
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app/src FRAUD_HOME=/app
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 && rm -rf /var/lib/apt/lists/*
COPY requirements requirements
RUN pip install --no-cache-dir -r requirements/serve.txt
COPY src src
COPY configs configs
COPY feature_repo feature_repo
COPY services services
COPY producer producer
COPY scripts scripts
RUN useradd -u 1000 -m app && mkdir -p data && chown -R app /app
USER app
