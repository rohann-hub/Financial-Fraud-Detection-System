FROM python:3.12-slim
RUN pip install --no-cache-dir mlflow==3.17.2
RUN mkdir -p /mlflow
# Its job workers are for GenAI features this project does not use, and they cost about 1.5 GB of memory.
ENV MLFLOW_SERVER_ENABLE_JOB_EXECUTION=false
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--workers", "1", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--artifacts-destination", "/mlflow/artifacts", "--allowed-hosts", "*", "--cors-allowed-origins", "*"]
